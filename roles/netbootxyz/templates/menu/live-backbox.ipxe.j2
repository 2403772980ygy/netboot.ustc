#!ipxe

goto ${menu} ||

:live_menu
set os BackBox
menu ${os}
item --gap ${os} Versions
{% for key, value in endpoints.items() | sort %}
{% if value.os == "BackBox" and 'squash' in key %}
item {{ value.version }} ${space} ${os} {{ value.version }}
{% endif %}
{% endfor %}
choose live_version || goto live_exit
goto ${live_version}

{% for key, value in endpoints.items() | sort %}
{% if value.os == "BackBox" and 'squash' in key %}
{% set kernel_name = value.kernel %}
:{{ value.version }}
{% if value.use_endpoint_mirror %}
set squash_url ${live_endpoint}{{ value.path }}filesystem.squashfs
{% else %}
set squash_url ${upstream_endpoint}{{ value.path }}filesystem.squashfs
{% endif %}
{% for key, value in endpoints.items() | sort %}
{% if key == kernel_name %}
{% if value.use_endpoint_mirror %}
set kernel_url ${live_endpoint}{{ value.path }}
{% else %}
set kernel_url ${upstream_endpoint}{{ value.path }}
{% endif %}
{% endif %}
{% endfor %}
goto boot-os
{% endif %}
{% endfor %}

:boot-os
imgfree
kernel ${kernel_url}vmlinuz ip=dhcp boot=casper netboot=url url=${squash_url} {{ kernel_params }}
initrd ${kernel_url}initrd
boot

:live_exit
clear menu
exit 0

